# ──────────────────────────────────────────────────────────
# Backend Environment Variables — Leave Management System
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leave_management
DB_USER=root
DB_PASSWORD=

# ── JWT Authentication ───────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-strong-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# ── Email (Resend) ───────────────────────────────────────
# Optional — email sending gracefully falls back to logging if not set
RESEND_API_KEY=
EMAIL_FROM=noreply@leavemanagement.com

# ── Redis (optional) ──────────────────────────────────────
# Optional — falls back to in-memory cache if not set
REDIS_URL=
