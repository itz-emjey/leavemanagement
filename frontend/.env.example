# ──────────────────────────────────────────────────────────
# Frontend Environment Variables — Leave Management System
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# API base URL (proxied in dev, direct in production)
# In development, Vite proxies /api to localhost:5000
# In production, nginx proxies /api to the backend container
VITE_API_URL=/api
