# ──────────────────────────────────────────────────────────
# Frontend Environment Variables — Leave Management System
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# Backend URL (proxied in dev, direct in production)
# In development, Vite proxies /api to localhost:5000
# In production, set VITE_BACKEND_URL to the full backend URL
# e.g. VITE_BACKEND_URL=https://backend-production-ebd1d.up.railway.app
VITE_BACKEND_URL=/api
